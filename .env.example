# ─── Vendly — переменные окружения ─────────────────────────────────────
# Скопируйте в .env и заполните. Файл .env в git не коммитится.

# ── Окружение ──────────────────────────────────────────────────────────
# development | production. На Railway прод определяется и по
# RAILWAY_ENVIRONMENT_NAME автоматически — вручную можно не задавать.
ENVIRONMENT=development

# ── Groq (основной LLM) ────────────────────────────────────────────────
# Получить бесплатно: https://console.groq.com → API Keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Классификатор интентов; пусто → используется GROQ_MODEL
GROQ_CLASSIFIER_MODEL=
# LLM-«мозг»: один структурный вызов на ход диалога. Включить в проде: 1
AI_BRAIN=0
GROQ_BRAIN_TEMPERATURE=0.5
# Максимум позиций каталога в одном промпте (ограничивает токены и 429)
LLM_CATALOG_MAX_ITEMS=120
# Сколько секунд уважать Retry-After при 429, прежде чем уйти в фоллбэк
GROQ_RETRY_MAX_WAIT=2.0

# ── Резервный LLM-провайдер (включается, когда заданы все три) ─────────
# OpenRouter: FALLBACK_BASE_URL=https://openrouter.ai/api/v1
#             FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
# Mistral:    FALLBACK_BASE_URL=https://api.mistral.ai/v1
#             FALLBACK_MODEL=mistral-large-latest
# ВАЖНО: модель должна поддерживать JSON-режим (response_format).
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# ── Алерт владельцу на всплеск деградированных ответов ─────────────────
DEGRADED_ALERT_RATIO=0.2
DEGRADED_ALERT_MIN_SAMPLES=10
DEGRADED_ALERT_WINDOW_SEC=600
DEGRADED_ALERT_COOLDOWN_SEC=1800

# ── Embeddings / RAG-поиск (опционально; требует Postgres + pgvector) ──
# Хостовый OpenAI-совместимый /v1/embeddings. EMBEDDING_DIM=384 совпадает
# с колонкой pgvector(384) — миграция БД не нужна. После настройки один
# раз выполнить: python backfill_embeddings.py
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIM=384
# Сколько модельных семейств RAG кладёт в промпт «мозга» за ход
BRAIN_RETRIEVAL_TOPK=20

# ── Telegram (дефолтный бот платформы) ─────────────────────────────────
# @BotFather → /newbot → токен. Вебхуку нужен HTTPS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
# Секрет, который Telegram возвращает в X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# ── База данных ────────────────────────────────────────────────────────
# Пусто → SQLite (файл DB_PATH); задан → Postgres (+pgvector)
DATABASE_URL=
DB_PATH=sneakers.db

# ── Redis (сессии и rate-limit; пусто → in-memory) ─────────────────────
REDIS_URL=
SESSION_TTL_SECONDS=86400
RATE_LIMIT_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── Авторизация дашборда ───────────────────────────────────────────────
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_TTL_DAYS=30

# ── Платформенный админ ────────────────────────────────────────────────
ADMIN_EMAIL=
# bcrypt-хэш пароля админа (обязателен в проде)
ADMIN_PASSWORD_HASH=
# ADMIN_PASSWORD (плейнтекст) устарел и НЕ используется — задавайте хэш.

# ── Магазин по умолчанию (дев-режим) ───────────────────────────────────
SHOP_SLUG=default
SHOP_NAME=Default shop

# ── Email-уведомления (Resend) ─────────────────────────────────────────
# https://resend.com → API Keys. Для тестов: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Vendly
# Гейт подтверждения email (включать после verify домена в Resend)
EMAIL_VERIFICATION_ENABLED=false
# Публичный URL приложения (кнопка «Открыть кабинет» в письмах)
SHOP_DASHBOARD_URL=

# ── Оплата подписки (ручная) ───────────────────────────────────────────
# Номер Kaspi Gold для перевода
PAYMENT_KASPI=
# Дополнительные инструкции (появятся во вкладке «Подписка»)
PAYMENT_DETAILS=

# ── Наблюдаемость (Sentry; пусто → выключено) ──────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Контакты поддержки (футер лендинга и дашборда; пусто → скрыто) ─────
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=

# ── CORS: origin-ы через запятую (обязателен в проде) ──────────────────
ALLOWED_ORIGINS=
